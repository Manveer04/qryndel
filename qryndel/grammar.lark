// Qryndel v0.1.0 public grammar

start: query

query: from_clause where_clause? return_clause
from_clause: "FROM" source_name alias?
source_name: NAME
alias: "AS" NAME

where_clause: "WHERE" or_expr
or_expr: and_expr ("OR" and_expr)*
and_expr: not_expr ("AND" not_expr)*
not_expr: "NOT" primary -> negated | primary
primary: condition | "(" or_expr ")"
condition: field operator value
         | field null_predicate
field: NAME
operator: OP
null_predicate: "IS" "NULL" -> is_null
              | "IS" "NOT" "NULL" -> is_not_null
value: PARAM | NAME | NUMBER | STRING | SINGLE_STRING

return_clause: "RETURN" field_list
field_list: field ("," field)*

OP: "=" | "!=" | ">" | "<" | ">=" | "<="
NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
PARAM: /\$[a-zA-Z_][a-zA-Z0-9_]*/
STRING: /"[^"]*"/
SINGLE_STRING: /'[^']*'/
NUMBER: /-?\d+(\.\d+)?/

%import common.WS
%ignore WS
